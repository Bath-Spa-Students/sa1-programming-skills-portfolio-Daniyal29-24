# main.py

class VendingMachine:
    def __init__(self):
        self.items = {
            "1": {"name": "Chips", "price": 1.50, "stock": 10},
            "2": {"name": "Soda", "price": 1.00, "stock": 8},
            "3": {"name": "Candy", "price": 0.75, "stock": 15},
            "4": {"name": "Water", "price": 1.25, "stock": 5},
        }
        self.balance = 0.0

    def display_items(self):
        print("\nItems available:")
        for key, item in self.items.items():
            print(f"{key}. {item['name']} - ${item['price']} (Stock: {item['stock']})")

    def insert_money(self, amount):
        if amount > 0:
            self.balance += amount
            print(f"Inserted ${amount:.2f}. Current balance: ${self.balance:.2f}")
        else:
            print("Invalid amount. Please insert a positive value.")

    def select_item(self, item_number):
        if item_number in self.items:
            item = self.items[item_number]
            if item["stock"] > 0:
                if self.balance >= item["price"]:
                    self.balance -= item["price"]
                    item["stock"] -= 1
                    print(f"Dispensed {item['name']}. Remaining balance: ${self.balance:.2f}")
                else:
                    print(f"Insufficient balance. {item['name']} costs ${item['price']:.2f}.")
            else:
                print(f"Sorry, {item['name']} is out of stock.")
        else:
            print("Invalid selection. Please choose a valid item number.")

    def refund(self):
        if self.balance > 0:
            print(f"Refunding ${self.balance:.2f}.")
            self.balance = 0.0
        else:
            print("No balance to refund.")

    def run(self):
        print("Welcome to the Vending Machine!")
        while True:
            self.display_items()
            print("\nOptions:")
            print("1. Insert Money")
            print("2. Select Item")
            print("3. Refund")
            print("4. Exit")
            choice = input("Choose an option: ")

            if choice == "1":
                try:
                    amount = float(input("Enter amount to insert: "))
                    self.insert_money(amount)
                except ValueError:
                    print("Invalid input. Please enter a valid amount.")
            elif choice == "2":
                item_number = input("Enter item number: ")
                self.select_item(item_number)
            elif choice == "3":
                self.refund()
            elif choice == "4":
                print("Thank you for using the Vending Machine. Goodbye!")
                break
            else:
                print("Invalid choice. Please try again.")


if __name__ == "__main__":
    vending_machine = VendingMachine()
    vending_machine.run()